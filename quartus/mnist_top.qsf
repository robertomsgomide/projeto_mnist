# -----------------------------------------------------------------------------
# mnist_top.qsf
# Projeto MNIST FPGA - DE0-CV / Cyclone V
# Controles externos via ESP32-S3 nos pinos GPIO_0.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Projeto / dispositivo
# -----------------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY mnist_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name SDC_FILE mnist_top.sdc

# Pinos nao usados em alta impedancia.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# Opcoes de otimizacao razoaveis para tentar fechar 50 MHz.
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE PERFORMANCE"
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM

# -----------------------------------------------------------------------------
# Arquivos VHDL do projeto
# -----------------------------------------------------------------------------
set_global_assignment -name VHDL_FILE ../VHDL/mnist_tipos_pkg.vhd
set_global_assignment -name VHDL_FILE ../VHDL/mascaras_top64_pkg.vhd
set_global_assignment -name VHDL_FILE ../VHDL/bias_densos_pkg.vhd
set_global_assignment -name VHDL_FILE ../VHDL/font_5x7_pkg.vhd

set_global_assignment -name VHDL_FILE ../VHDL/acumuladores_digitos.vhd
set_global_assignment -name VHDL_FILE ../VHDL/argmax10.vhd
set_global_assignment -name VHDL_FILE ../VHDL/argmax10_signed.vhd
set_global_assignment -name VHDL_FILE ../VHDL/pontuador_top64_digit.vhd
set_global_assignment -name VHDL_FILE ../VHDL/classificador_binario_top64.vhd
set_global_assignment -name VHDL_FILE ../VHDL/rom_pesos_densos.vhd
set_global_assignment -name VHDL_FILE ../VHDL/classificador_denso_seq.vhd
set_global_assignment -name VHDL_FILE ../VHDL/reg_resultados.vhd
set_global_assignment -name VHDL_FILE ../VHDL/mnist_fd.vhd

set_global_assignment -name VHDL_FILE ../VHDL/sincronizador_sinais.vhd
set_global_assignment -name VHDL_FILE ../VHDL/detector_borda.vhd
set_global_assignment -name VHDL_FILE ../VHDL/interface_entrada.vhd
set_global_assignment -name VHDL_FILE ../VHDL/mnist_canvas.vhd
set_global_assignment -name VHDL_FILE ../VHDL/mnist_uc.vhd

set_global_assignment -name VHDL_FILE ../VHDL/uart_rx.vhd
set_global_assignment -name VHDL_FILE ../VHDL/uart_tx.vhd
set_global_assignment -name VHDL_FILE ../VHDL/uart_packet_rx.vhd
set_global_assignment -name VHDL_FILE ../VHDL/uart_packet_tx_ack.vhd
set_global_assignment -name VHDL_FILE ../VHDL/uart_frame_buffer.vhd
set_global_assignment -name VHDL_FILE ../VHDL/uart_frontend.vhd

set_global_assignment -name VHDL_FILE ../VHDL/display7seg.vhd
set_global_assignment -name VHDL_FILE ../VHDL/display7seg_ctrl.vhd
set_global_assignment -name VHDL_FILE ../VHDL/leds_ctrl.vhd
set_global_assignment -name VHDL_FILE ../VHDL/interface_saida.vhd

set_global_assignment -name VHDL_FILE ../VHDL/divisor_clock_25mhz.vhd
set_global_assignment -name VHDL_FILE ../VHDL/contador_pixel.vhd
set_global_assignment -name VHDL_FILE ../VHDL/vga_sync_640x480.vhd
set_global_assignment -name VHDL_FILE ../VHDL/vga_render_mnist.vhd
set_global_assignment -name VHDL_FILE ../VHDL/vga_render_fonts.vhd
set_global_assignment -name VHDL_FILE ../VHDL/vga_render_layout.vhd
set_global_assignment -name VHDL_FILE ../VHDL/vga_top.vhd

set_global_assignment -name VHDL_FILE ../VHDL/mnist_top.vhd

# -----------------------------------------------------------------------------
# Clock da DE0-CV
# -----------------------------------------------------------------------------
set_location_assignment PIN_M9 -to clock_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clock_50

# -----------------------------------------------------------------------------
# Interface ESP32-S3 <-> FPGA via GPIO_0
#
# Mapeamento proposto:
#   escreve        : ESP32-S3 -> DE0-CV GPIO_0_D0
#   apaga          : ESP32-S3 -> DE0-CV GPIO_0_D1
#   classifica     : ESP32-S3 -> DE0-CV GPIO_0_D2
#   uart_rx_serial : ESP32-S3 TX -> FPGA RX / DE0-CV GPIO_0_D3
#   uart_tx_serial : FPGA TX -> ESP32-S3 RX / DE0-CV GPIO_0_D4
#
# Importante: GND comum entre ESP32-S3 e DE0-CV. Sinais em 3,3 V.
# -----------------------------------------------------------------------------
set_location_assignment PIN_N16 -to escreve
set_location_assignment PIN_B16 -to apaga
set_location_assignment PIN_M16 -to classifica
set_location_assignment PIN_C16 -to uart_rx_serial
set_location_assignment PIN_D17 -to uart_tx_serial

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to escreve
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to apaga
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to classifica
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx_serial
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx_serial
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to uart_rx_serial

# -----------------------------------------------------------------------------
# LEDs vermelhos da DE0-CV
# -----------------------------------------------------------------------------
set_location_assignment PIN_AA2 -to ledr[0]
set_location_assignment PIN_AA1 -to ledr[1]
set_location_assignment PIN_W2 -to ledr[2]
set_location_assignment PIN_Y3 -to ledr[3]
set_location_assignment PIN_N2 -to ledr[4]
set_location_assignment PIN_N1 -to ledr[5]
set_location_assignment PIN_U2 -to ledr[6]
set_location_assignment PIN_U1 -to ledr[7]
set_location_assignment PIN_L2 -to ledr[8]
set_location_assignment PIN_L1 -to ledr[9]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[9]

